# ══════════════════════════════════════════════════════════════════
#  TechBharat Buildathon — Agentic AI Meeting Assistant
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ══════════════════════════════════════════════════════════════════

# ── MySQL Database ────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=meeting_assistant
MYSQL_USER=meeting_user
MYSQL_PASSWORD=meeting_password

# Docker internal connection backend
MYSQL_HOST=db
MYSQL_PORT=3306

# Host machine access (Workbench)
MYSQL_HOST_PORT=3307

# ── FastAPI Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Streamlit Frontend ────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Google Gemini (Primary LLM) ──────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Grok / xAI (Fallback LLM) ────────────────────────────────────
# Optional. Leave blank to disable fallback.
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta
GROK_BASE_URL=https://api.x.ai/v1

# ── GitHub Integration ────────────────────────────────────────────
# Create PAT at: GitHub → Settings → Developer Settings → Tokens (classic)
# Required scopes: repo
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=YourUsername/YourRepoName

# ── Application Config ────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.txt,.vtt,.srt

# ── Feature Kill Switches ─────────────────────────────────────────
# Set to false to disable integration during demo (graceful degradation)
ENABLE_GITHUB=true
ENABLE_GROK_FALLBACK=true

# ── LLM Retry Policy ─────────────────────────────────────────────
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=2
